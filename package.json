{
  "name": "@kiln/engine",
  "private": true,
  "version": "0.6.0",
  "description": "Create and refine procedural 3D assets with JavaScript, image feedback, and reusable source revisions.",
  "license": "MIT",
  "author": "Matthew Kissinger",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "1.4.2",
    "node": "22.23.2",
    "npm": "12.0.2"
  },
  "bin": {
    "kiln": "./dist/cli.mjs",
    "kiln-init": "./scripts/create-workspace.mjs"
  },
  "exports": {
    "./assets": "./src/assets.ts",
    "./assets/node": "./src/assets-node.ts",
    ".": "./src/cli.ts",
    "./agent": "./src/agent/index.ts",
    "./tools": "./src/tools/registry.ts",
    "./arena": "./src/arena/index.ts",
    "./render": "./src/render.ts",
    "./evaluator": "./src/evaluator/index.ts",
    "./kit": "./src/kit.ts",
    "./palette": "./src/palette.ts",
    "./views": "./src/views/index.ts",
    "./validation": "./src/validation.ts",
    "./primitives": "./src/primitives.ts",
    "./geometry": "./src/geometry.ts",
    "./deform": "./src/deform.ts",
    "./sweep": "./src/sweep.ts",
    "./implicit": "./src/implicit.ts",
    "./programs": "./src/program-store.ts",
    "./programs/node": "./src/program-store-node.ts",
    "./cache": "./src/build-cache.ts",
    "./cache/node": "./src/build-cache-node.ts",
    "./profile": "./src/profile.ts",
    "./architecture": "./src/architecture.ts",
    "./character": "./src/character.ts",
    "./vehicle": "./src/vehicle.ts",
    "./material-recipes": "./src/material-recipes.ts",
    "./material-resources": "./src/material-resources.ts",
    "./texture-resolver": "./src/texture-resolver.ts",
    "./material-recipe-runtime": "./src/material-recipe-runtime.ts",
    "./material-recipe-prompt": "./src/material-recipe-prompt.ts",
    "./material-metrics": "./src/material-metrics.ts",
    "./prompt": "./src/prompt.ts",
    "./prompt-api": "./src/prompt-api.ts",
    "./list-primitives": "./src/list-primitives.ts",
    "./metrics": "./src/metrics.ts",
    "./inspect": "./src/inspect.ts",
    "./contracts": "./src/contracts/index.ts",
    "./qa": "./src/qa/index.ts",
    "./composer": "./src/composer/index.ts",
    "./composer/agent": "./src/composer/agent/index.ts",
    "./world-runtime": "./src/composer/terrain-runtime.ts"
  },
  "files": [
    "dist/viewer/",
    "src/**/*.ts",
    "src/**/*.mjs",
    "!src/**/*.test.ts",
    "!src/**/__tests__/**",
    "dist/*.mjs",
    "dist/build.json",
    "plugin.json",
    ".claude-plugin/",
    ".codex-plugin/",
    ".mcp.json",
    "scripts/create-workspace.mjs",
    "scripts/package-plugin.mjs",
    "render-service/src/",
    "render-service/package.json",
    "render-service/package-lock.json",
    "render-service/README.md",
    "skills/",
    "docs/",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "kiln": "bun src/cli.ts",
    "check:toolchain": "bun scripts/check-toolchain.mjs",
    "check:skills": "node scripts/check-skills.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "build:mcp": "node scripts/build-runtime.mjs mcp",
    "build:cli": "node scripts/build-runtime.mjs cli",
    "build:worker": "node scripts/build-runtime.mjs worker",
    "build:runtime": "node scripts/build-viewer.mjs && node scripts/build-runtime.mjs all",
    "build:viewer": "node scripts/build-viewer.mjs",
    "docs:tools": "bun scripts/generate-tool-reference.ts",
    "test": "KILN_SPIKE_LIVE=0 KILN_RENDER=cpu bun test src scripts",
    "test:coverage": "KILN_SPIKE_LIVE=0 KILN_RENDER=cpu bun test src scripts --coverage && bun scripts/check-coverage.mjs",
    "test:live": "KILN_SPIKE_LIVE=1 bun test",
    "test:package": "node scripts/test-plugin-package.mjs && node scripts/smoke-package.mjs",
    "lint": "biome check .",
    "verify:posters": "bun scripts/verify-posters.mjs",
    "site:assets": "cd site && bun scripts/build-assets.mjs",
    "site:skills": "cd site && bun scripts/build-skills-discovery.mjs",
    "site:dev": "bun run --cwd site dev",
    "site:build": "bun run --cwd site build",
    "smoke:harness": "node scripts/harness-smoke.mjs"
  },
  "dependencies": {
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@gltf-transform/functions": "4.5.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@openrouter/ai-sdk-provider": "^2.10.0",
    "@types/three": "^0.186.0",
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "gltf-validator": "2.0.0-dev.3.10",
    "manifold-3d": "^3.5.3",
    "sharp": "^0.35.4",
    "three": "0.186.0",
    "three-subdivide": "^1.1.5",
    "xatlasjs": "^0.2.0",
    "zod": "^4.6.2"
  },
  "peerDependencies": {
    "@ai-sdk/provider": "^3.0.0",
    "@strands-agents/sdk": "^1.4.0"
  },
  "overrides": {
    "sharp": "^0.35.4"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/provider": {
      "optional": true
    },
    "@strands-agents/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/provider": "^3.0.14",
    "@anthropic-ai/sdk": "^0.125.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1083.0",
    "@biomejs/biome": "^2.5.13",
    "@google/genai": "^2.22.0",
    "@strands-agents/sdk": "1.17.0",
    "@types/bun": "^1.4.2",
    "ai": "^6.0.222",
    "openai": "^6.46.0",
    "typescript": "^7.0.2"
  }
}
